extends "res://tests/cast_network_animation_validation.gd"
const Actions = preload("res://tests/village_task_actions.gd")

func run_checks() -> void:
	await super.run_checks()
	if not failures.is_empty(): return
	var host := apps[0]
	var code: String = host.get("room_code")
	var room: Dictionary = server.get("rooms")[code]
	var villager: Control
	for app in apps:
		var peer_id: int = app.get("network_manager").local_peer_id()
		if str(room["players"][peer_id]["role"])=="villager": villager=app; break
	if villager==null: check(false,"Villager available for real task input"); return
	var peer_id: int = villager.get("network_manager").local_peer_id()
	for index in Data.COMMON_TASKS.size():
		var point: Vector2 = Geometry.task_points(1)[index]
		room["players"][peer_id]["position"]=point
		room["players"][peer_id]["direction"]=Vector2.ZERO
		server.call("_broadcast_positions",code,true)
		if not await wait_for(func()->bool:return villager.get("player_position").distance_to(point)<1,"villager reaches task station"): return
		villager.call("open_task",index)
		check(is_instance_valid(villager.get("task_minigame")),"Real LAN villager opens task %d"%index)
		for step in Data.COMMON_TASK_STEPS[index]:
			var board: Control = villager.get("task_minigame")
			if not is_instance_valid(board): check(false,"Network task board remains until complete"); return
			Actions.complete_step(board,true)
			if not await wait_for(func()->bool:return int(room["task_progress"][index])>step,"server accepts task %d stage %d"%[index,step]): return
			if step+1 < Data.COMMON_TASK_STEPS[index]:
				if not await wait_for(func()->bool:return is_instance_valid(villager.get("task_minigame")) and villager.get("task_minigame").current_progress==step+1 and villager.get("task_minigame").input_enabled,"task acknowledgement resumes input"): return
		check(room["completed_tasks"][index]==1,"Server completes %s"%Data.COMMON_TASKS[index]["name"])
		if not await wait_for(func()->bool:return apps.all(func(a:Control)->bool:return a.get("completed_tasks")[index]==1),"all five clients receive task completion"): return
	check(room["completed_tasks"].count(1)==Data.COMMON_TASKS.size(),"All twelve new chores are authoritative and shared")
	if await wait_for(func()->bool:return apps.all(func(a:Control)->bool:return a.get("current_screen")=="result"),"all players see the village victory"):
		check(true,"Completing all twelve tasks ends the LAN match for everyone")
